# Copy to .env and adjust as needed.
# None of these are required; defaults work if you have Ollama running locally.

# Provider selection (defaults to local Ollama)
# - ollama: local models via Ollama
# - gemini: cloud Gemini via Google AI Studio (requires GOOGLE_API_KEY)
RAG_LLM_PROVIDER=ollama
RAG_EMBED_PROVIDER=ollama

GOOGLE_API_KEY=
# Optional: if Ollama is not on the default localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Ollama models
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2

# Chroma persistence
# CHROMA_MODE can be:
# - local (default): stores in CHROMA_DIR on disk
# CHROMA_MODE=local
# CHROMA_DIR=./chroma_db
# CHROMA_COLLECTION=calltourai
# - http: stores in a remote Chroma server over HTTP
# - cloud: stores in Chroma Cloud (recommended config uses CHROMA_HOST/CHROMA_API_KEY)

# Chroma remote/Cloud settings (only used when CHROMA_MODE=http)
# Chroma Cloud settings (use these when connecting to api.trychroma.com)
# CHROMA_MODE=cloud
# CHROMA_HOST=api.trychroma.com
# CHROMA_API_KEY=YOUR_CHROMA_API_KEY
# CHROMA_TENANT=your-tenant-id
# CHROMA_DATABASE=your-database-name

# Self-hosted Chroma over HTTP (alternative)
# CHROMA_MODE=http
# CHROMA_HTTP_HOST=localhost
# CHROMA_HTTP_PORT=8000
# CHROMA_HTTP_SSL=false
# CHROMA_HTTP_API_KEY=YOUR_API_KEY_IF_NEEDED
CHROMA_HTTP_API_KEY=ck-5VZJocKTEn5d4xocFvnxpX7M5XJ4BYqLkwZZDakCaocS
# Optional multi-tenant settings (if your Chroma deployment supports it):
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=default_database

# Retrieval
RAG_TOP_K=3

# Cloud (Gemini). Only needed if you set provider=gemini.
# Get a key from Google AI Studio and set it here:
# GOOGLE_API_KEY=YOUR_KEY_HERE
GEMINI_LLM_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=text-embedding-004

# LIVEKIT_URL=