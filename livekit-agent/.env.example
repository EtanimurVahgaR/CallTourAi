# LiveKit Configuration (Optional - only needed if you want to connect to a LiveKit server)
# Local dev server defaults:
#   LIVEKIT_URL=ws://127.0.0.1:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Developer API (Required)
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key

# Optional Gemini Live tuning
# IMPORTANT: Gemini Live websocket requires a model that supports bidiGenerateContent.
# Use a native-audio model id.
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest
GEMINI_VOICE=Puck

# Logging
LOG_LEVEL=INFO

# Persistent agent memory (PostgreSQL via SQLAlchemy)
# If DATABASE_URL is set, the LiveKit agent will persist sanitized chat history
# keyed by room name (+ optional user identity) so memory survives reconnects.
# Example:
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/calltourai
DATABASE_URL=

# How much history to persist (last N items)
MEMORY_MAX_ITEMS=200

# Optional: if true, scope memory by (room_name, user_identity).
# This requires the client to reconnect with the SAME identity.
MEMORY_SCOPE=room

# How much of the persisted history to inject into the agent prompt
MEMORY_PROMPT_MAX_MESSAGES=20
MEMORY_PROMPT_MAX_CHARS=4000

# If multiple users join the room, you can pin the agent session to one user identity.
# TARGET_PARTICIPANT_IDENTITY=web-user
TARGET_PARTICIPANT_IDENTITY=
